# PostgreSQL (see docker-compose.yml for local dev defaults)
DATABASE_URL="postgresql://adslott:adslott@localhost:5432/adslott?schema=public"

# Session cookie encryption key (min 32 characters). Generate with:
# openssl rand -base64 32
SESSION_SECRET="change-me-to-a-random-32-character-secret"

# Business rules (all amounts in cents)
SLOT_START_PRICE_CENTS=100
MIN_BID_INCREMENT_CENTS=50
STARTING_WALLET_CENTS=5000

# Timezone used for the daily reset
RESET_TIMEZONE="Europe/Paris"
